---
/*
 * Bloc « video » : titre, texte, puis une vidéo YouTube en 16:9. Le lecteur
 * (chargement au clic, accessibilité) est dans LecteurVideo, partagé avec la
 * directive Markdown ::video.
 */
import LecteurVideo from '@/components/partage/LecteurVideo.astro'
import Titre from './Titre.astro'
import TexteMarkdown from './TexteMarkdown.astro'
import type { BlocDe } from './types'

type Props = { bloc: BlocDe<'video'> }

const { bloc } = Astro.props
---

<Titre texte={bloc.titre} id={bloc.id} />
{bloc.texte && <TexteMarkdown texte={bloc.texte} brut />}
<LecteurVideo youtube={bloc.youtube} titreVideo={bloc.titreVideo} image={bloc.image} transcription={bloc.transcription} />
