---
/*
 * « Accès rapide » du menu (PanneauMenu) : les tâches courantes et À propos
 * (LIENS_MENU), en six tuiles bleues. Au bureau, dernière colonne, à droite,
 * sous le bouton Menu (loi de Fitts) ; le surtitre n'y est plus affiché mais
 * nomme toujours la liste.
 *
 * PanneauMenu passe `class="groupe"` : sa propre portée de style atteint
 * ainsi la racine (placement dans la grille, entrée en décalage, écart des
 * tuiles --ecart-tuiles).
 */
import { ArrowUpRightIcon } from '@phosphor-icons/react/dist/ssr/ArrowUpRight'
import { sansBase } from '@/lib/chemin'
import { LIENS_MENU, estCourante, estExterne } from '@/data/navigation'
import IconeSprite from '@/components/icones/IconeSprite.astro'

interface Props {
  /** id du menu : préfixe de l'id du surtitre */
  id: string
  class?: string
  style?: string
}

const { id, class: classe, style, ...reste } = Astro.props
const chemin = sansBase(Astro.url.pathname)
const cibleExterne = (href: string) => (estExterne(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})
const courante = (url: string) => (url === '/' ? chemin === '/' : estCourante(chemin, url))
---

<div class:list={[classe, 'acces']} style={style} {...reste}>
  <p class="surtitre" id={`${id}-acces`}>Accès rapide</p>
  <ul class="tuiles" aria-labelledby={`${id}-acces`}>
    {
      LIENS_MENU.map(({ libelle, href, Icone, clair }) => (
        <li>
          <a class:list={{ 'tuile-claire': clair }} href={href} {...cibleExterne(href)} aria-current={!estExterne(href) && courante(href) ? 'page' : undefined}>
            <IconeSprite icone={Icone} size={24} aria-hidden="true" className="icone" />
            <span class="tuile-libelle">
              {libelle}
              {estExterne(href) && <span class="visuellement-masque"> (nouvel onglet)</span>}
            </span>
            {estExterne(href) && <IconeSprite icone={ArrowUpRightIcon} size={14} aria-hidden="true" className="externe" />}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .tuiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ecart-tuiles);
  }

  .tuiles a {
    display: flex;
    position: relative;
    flex-direction: column;
    gap: var(--espace-1);
    height: 100%;
    min-height: 5.5rem;
    padding: 0.875rem;
    border-radius: var(--rayon-tres-petit);
    background-color: var(--bleu-principal);
    color: var(--couleur-sur-fonce);
    font-size: var(--texte-reduit);
    font-weight: var(--graisse-moyenne);
    line-height: 1.3;
    transition:
      background-color var(--duree-courte-4) var(--courbe-standard),
      scale var(--duree-courte-2) var(--courbe-standard);
  }

  /* Retour à l'appui, au doigt comme à la souris */
  .tuiles a:active {
    scale: 0.97;
  }

  /* Bleu UdeM, texte et icônes blancs (7,05:1) ; plus foncé au survol */
  .tuiles a:hover {
    background-color: var(--bleu-principal-fonce);
    color: var(--couleur-sur-fonce);
  }

  /* Tuile bleu clair (Nous joindre, À propos) : bleu foncé sur bleu 100,
     15,7:1 ; bleu 200 au survol */
  .tuiles a.tuile-claire {
    background-color: var(--bleu-100);
    color: var(--bleu-fonce);
  }

  .tuiles a.tuile-claire:hover {
    background-color: var(--bleu-200);
    color: var(--bleu-fonce);
  }

  .tuiles :global(.externe) {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
  }

  /* Sur deux colonnes, une dernière tuile seule prend toute la rangée */
  .tuiles li:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .tuile-libelle {
    overflow-wrap: anywhere;
  }

  @media (width >= 600px) {
    .tuiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .tuiles li:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }

  @media (width >= 900px) {
    .tuiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tuiles li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (width >= 1200px) {
    .acces .surtitre {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* Les trois rangées de tuiles se partagent la hauteur de l'aperçu, à
       côté : bas alignés, sans carré imposé (les carrés étiraient l'aperçu
       et y laissaient un grand vide). Une tuile grandit si son libellé (ou
       le texte agrandi) l'exige. */
    .tuiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 1fr;
      height: 100%;
    }

    .tuiles a {
      min-height: 5.5rem;
      padding: 0.75rem;
    }

    /* Icône en haut, libellé en bas, coupé entre les mots seulement */
    .tuile-libelle {
      margin-top: auto;
      overflow-wrap: break-word;
    }

    .tuiles li:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }

  @media (forced-colors: active) {
    .tuiles a {
      border: 1px solid CanvasText;
    }
  }
</style>
