---
/*
 * Premier groupe du menu (PanneauMenu) : la recherche (RechercheMenu), avec
 * à côté la suite du parcours Sofia (Mon dossier, Obtenir un document).
 * Seul groupe affiché en mode recherche.
 *
 * PanneauMenu passe `class="groupe"` : sa propre portée de style atteint
 * ainsi la racine (placement dans la grille, entrée en décalage, mode
 * recherche).
 */
import { ArrowRightIcon } from '@phosphor-icons/react/dist/ssr/ArrowRight'
import { ArrowUpRightIcon } from '@phosphor-icons/react/dist/ssr/ArrowUpRight'
import { LIENS_SOFIA, estExterne } from '@/data/navigation'
import RechercheMenu from '../RechercheMenu.astro'
import IconeSprite from '@/components/icones/IconeSprite.astro'

interface Props {
  /** id du menu : préfixe des id du champ */
  id: string
  class?: string
  style?: string
}

const { id, class: classe, style, ...reste } = Astro.props
const cibleExterne = (href: string) => (estExterne(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})
---

<div class:list={[classe, 'sofia']} style={style} {...reste}>
  <RechercheMenu id={`${id}-sofia`} />
  <ul class="sofia-liens" aria-label="Sofia : suite du parcours">
    {
      LIENS_SOFIA.map(({ libelle, href, Icone }) => (
        <li>
          <a href={href} {...cibleExterne(href)}>
            <IconeSprite icone={Icone} size={20} aria-hidden="true" className="icone" />
            {libelle}
            {estExterne(href) && <span class="visuellement-masque"> (nouvel onglet)</span>}
            {estExterne(href) ? <IconeSprite icone={ArrowUpRightIcon} size={14} aria-hidden="true" /> : <IconeSprite icone={ArrowRightIcon} size={14} aria-hidden="true" />}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { brancherRechercheSofia } from '@/lib/sofia'

  brancherRechercheSofia()
</script>

<style>
  /* ---- Suite du parcours Sofia : liens sous le champ (à côté dès 900 px) ---- */
  .sofia-liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--espace-2);
    margin: var(--espace-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .sofia-liens a {
    display: inline-flex;
    align-items: center;
    gap: var(--espace-1);
    min-height: 2.75rem;
    color: var(--couleur-texte);
    font-weight: var(--graisse-moyenne);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--couleur-accent) 45%, transparent);
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--duree-courte-4) var(--courbe-standard);
  }

  .sofia-liens a:hover {
    color: var(--couleur-texte);
    text-decoration-color: currentColor;
  }

  .sofia-liens :global(svg) {
    flex-shrink: 0;
    color: var(--couleur-accent);
  }

  @media (width >= 900px) {
    /* Liens au niveau du champ (l'étiquette du champ est au-dessus) */
    .sofia-liens {
      margin: 0;
      padding-bottom: 0.25rem;
    }
  }
</style>
