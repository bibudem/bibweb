---
/*
 * Bouton « Retour en haut de la page », fixé en bas à droite.
 *
 * - Il apparaît quand on a défilé de plus d'un écran et demi, et disparaît en
 *   haut de page. Masqué, il est `visibility: hidden` : il sort aussi de
 *   l'ordre de tabulation et de l'arbre d'accessibilité. Sans JS, il reste
 *   masqué (le défilement natif suffit : Début, ou le lien d'évitement).
 * - Un vrai <button> avec un nom accessible (l'icône est décorative). Cible de
 *   48 px, 40 × 48 px en onglet (WCAG 2.5.8 demande 24 px).
 * - Au clic : défilement jusqu'en haut (instantané avec mouvement réduit, via
 *   la règle globale de scroll-behavior), puis le focus revient au début du
 *   document sans le montrer : le Tab suivant atteint le lien d'évitement,
 *   comme à l'arrivée sur la page. Laisser le focus sur le bouton, devenu
 *   masqué, le ferait disparaître sous le clavier (WCAG 2.4.3).
 * - ≥ 900 px : onglet collé au bord droit, dans la même colonne de 40 px que
 *   la poignée du tiroir des liens rapides (elle au centre, lui en bas, au-
 *   dessus du rond de clavardage) : il reste dans la marge et ne recouvre
 *   jamais le texte.
 *   < 900 px : au-dessus de la barre des liens rapides ; il sort entièrement
 *   de l'écran avec elle au défilement vers le bas (lecture) et revient avec
 *   elle quand on remonte (--retrait-liens-rapides, de 0 à 1). Il se retire
 *   aussi après 2,5 s sans défilement, sauf s'il a le focus.
 * - Bleu principal, comme le tiroir des liens rapides (bleu foncé au
 *   survol). Contraste du pictogramme blanc : 7,1:1 au repos.
 * - Infobulle « Retour en haut » à gauche, au survol et au focus clavier,
 *   comme la poignée du tiroir : Échap la ferme, le pointeur peut passer
 *   dessus (WCAG 1.4.13).
 * - Focus : anneau marine avec un liseré blanc, lisible sur fond clair comme
 *   sur les bandes foncées.
 * - Mode contraste forcé : bordure système. Impression : masqué.
 */
import { ArrowUpIcon } from '@phosphor-icons/react/dist/ssr/ArrowUp'
import IconeSprite from '@/components/icones/IconeSprite.astro'
---

<button type="button" class="retour-haut infobulle infobulle-gauche" data-retour-haut aria-label="Retour en haut de la page" data-infobulle="Retour en haut">
  <IconeSprite icone={ArrowUpIcon} size={24} weight="bold" aria-hidden="true" />
</button>

<script>
  import { aChaquePage, auDepart } from '@/lib/pages'

  aChaquePage((signal) => {
    const bouton = document.querySelector<HTMLButtonElement>('[data-retour-haut]')
    if (!bouton) return

    let enAttente = false
    // Sous 900 px, il flotte sur le contenu : il se retire aussi après REPOS
    // ms sans défilement (arrêté sur un passage, on lit) ; dès 900 px, il
    // est dans la marge et reste affiché.
    const large = window.matchMedia('(width >= 900px)')
    const REPOS = 2500
    let auRepos = false
    let minuterieRepos: ReturnType<typeof setTimeout> | undefined
    const mettreAJour = () => {
      enAttente = false
      const loin = window.scrollY > window.innerHeight * 1.5
      // Le focus (ou le doigt, le pointeur) le garde affiché : il ne
      // disparaît pas sous le clavier ni au moment de le toucher
      const garde = bouton.matches(':focus-visible, :hover, :active')
      bouton.toggleAttribute('data-visible', loin && (large.matches || garde || !auRepos))
    }
    large.addEventListener('change', mettreAJour, { signal })
    window.addEventListener(
      'scroll',
      () => {
        auRepos = false
        clearTimeout(minuterieRepos)
        minuterieRepos = setTimeout(() => {
          auRepos = true
          mettreAJour()
        }, REPOS)
        if (enAttente) return
        enAttente = true
        requestAnimationFrame(mettreAJour)
      },
      { passive: true, signal },
    )
    auDepart(signal, () => clearTimeout(minuterieRepos))
    // Quitter le bouton sans l'avoir utilisé : la minuterie a pu passer
    bouton.addEventListener('blur', mettreAJour)
    window.addEventListener('resize', mettreAJour, { passive: true, signal })

    // Échap ferme l'infobulle ; elle revient au prochain survol ou focus
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && bouton.matches(':hover, :focus-visible')) bouton.setAttribute('data-infobulle-fermee', '')
    }, { signal })
    for (const evenement of ['pointerleave', 'blur']) {
      bouton.addEventListener(evenement, () => bouton.removeAttribute('data-infobulle-fermee'))
    }
    mettreAJour()

    bouton.addEventListener('click', () => {
      window.scrollTo({ top: 0 })
      // Point de départ de la navigation au clavier : le haut du document
      const corps = document.body
      corps.setAttribute('tabindex', '-1')
      corps.style.outline = 'none'
      corps.focus({ preventScroll: true })
      corps.addEventListener(
        'blur',
        () => {
          corps.removeAttribute('tabindex')
          corps.style.removeProperty('outline')
        },
        { once: true },
      )
    })
  })
</script>

<style>
  .retour-haut {
    --_ecart: 1rem;
    display: grid;
    position: fixed;
    /* Un cran au-dessus du clavardage flottant (BoutonClavardage, même
       niveau) : son infobulle passe toujours devant le rond */
    z-index: calc(var(--z-entete) + 1);
    right: var(--_ecart);
    /* < 900 px : au-dessus de la pastille de clavardage (3 rem + 0,75 rem) */
    bottom: calc(var(--hauteur-liens-rapides, 86px) + var(--_ecart) + 3.75rem + var(--decalage-consentement, 0px));
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: var(--bleu-principal);
    box-shadow: var(--ombre-2);
    color: var(--couleur-sur-fonce);
    cursor: pointer;
    visibility: hidden;
    opacity: 0;
    translate: 0 0.75rem;
    transition:
      opacity var(--duree-courte-4) var(--courbe-standard-acceleree),
      translate var(--duree-courte-4) var(--courbe-standard-acceleree),
      visibility 0s linear var(--duree-courte-4),
      background-color var(--duree-courte-4) var(--courbe-standard);
  }

  .retour-haut[data-visible] {
    visibility: visible;
    opacity: 1;
    translate: 0 0;
    transition:
      opacity var(--duree-moyenne-1) var(--courbe-standard-deceleree),
      translate var(--duree-moyenne-1) var(--courbe-standard-deceleree),
      visibility 0s,
      background-color var(--duree-courte-4) var(--courbe-standard);
  }

  /* Sous 900 px, la barre des liens rapides sort de l'écran au défilement
     vers le bas, au rythme du doigt (LiensRapides) : le bouton descend avec
     elle, jusqu'à l'écart habituel du bas de l'écran. transform s'ajoute au
     translate de l'apparition sans le remplacer. */
  @media (width < 900px) {
    .retour-haut {
      /* Il sort entièrement de l'écran avec la barre : pendant la lecture
         (défilement vers le bas), il ne recouvre plus le texte ; il revient
         avec elle dès qu'on remonte, quand on cherche à revenir en haut. */
      transform: translateY(calc(var(--retrait-liens-rapides, 0) * (var(--hauteur-liens-rapides, 86px) + var(--_ecart) + 3.75rem + 3rem + 1rem)));
      transition:
        opacity var(--duree-courte-4) var(--courbe-standard-acceleree),
        translate var(--duree-courte-4) var(--courbe-standard-acceleree),
        visibility 0s linear var(--duree-courte-4),
        background-color var(--duree-courte-4) var(--courbe-standard),
        transform var(--duree-courte-4) var(--courbe-standard);
    }

    .retour-haut[data-visible] {
      transition:
        opacity var(--duree-moyenne-1) var(--courbe-standard-deceleree),
        translate var(--duree-moyenne-1) var(--courbe-standard-deceleree),
        visibility 0s,
        background-color var(--duree-courte-4) var(--courbe-standard),
        transform var(--duree-courte-4) var(--courbe-standard);
    }

    /* Pendant que le doigt déplace la barre, le bouton la suit sans retard */
    :global(body:has([data-liens-rapides-mobile][data-suit])) .retour-haut {
      transition-duration: var(--duree-courte-4), var(--duree-courte-4), 0s, var(--duree-courte-4), 0s;
    }

    :global(body:has([data-liens-rapides-mobile][data-suit])) .retour-haut[data-visible] {
      transition-duration: var(--duree-moyenne-1), var(--duree-moyenne-1), 0s, var(--duree-courte-4), 0s;
    }

    /* Le focus ramène la barre entière : le bouton reprend sa place au-dessus */
    :global(body:has([data-liens-rapides-mobile]:focus-within)) .retour-haut {
      transform: none;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .retour-haut:hover {
      background-color: var(--bleu-fonce);
    }
  }

  /* Infobulle (utilitaire .infobulle de global.css) : muette tant que le
     bouton est masqué, sa visibilité l'emporterait sur celle du bouton */
  .retour-haut:not([data-visible]) {
    --infobulle-visibilite: hidden;
    --infobulle-opacite: 0;
  }

  .retour-haut:focus-visible {
    outline: 3px solid var(--bleu-fonce);
    outline-offset: 3px;
    box-shadow: 0 0 0 3px var(--couleur-surface);
  }

  .retour-haut :global(svg) {
    display: block;
  }

  /* ≥ 900 px : un onglet collé au bord droit, comme la poignée du tiroir des
     liens rapides (même colonne de 40 px, en bas plutôt qu'au centre). Il
     reste dans la marge et ne recouvre plus le texte, qui s'arrête au moins
     40 px avant le bord (64 px de gouttière dès 1200 px). */
  @media (width >= 900px) {
    .retour-haut {
      --_ecart: 1.5rem;
      right: 0;
      /* En colonne au-dessus du rond de clavardage (comme sous 900 px) :
         l'infobulle, à gauche, s'ouvre au-dessus du rond et de son libellé,
         sans passer derrière. 6,75 rem = libellé (2,5) + rond (3,5) + écart
         (0,75) de BoutonClavardage. Plus haut encore tant que la bannière de
         consentement est affichée (--decalage-consentement). */
      bottom: calc(var(--_ecart) + 6.75rem + var(--decalage-consentement, 0px));
      width: 40px;
      height: 48px;
      border-radius: var(--rayon-petit) 0 0 var(--rayon-petit);
      translate: 0.75rem 0;
    }

    .retour-haut[data-visible] {
      translate: 0 0;
    }

    .retour-haut :global(svg) {
      width: 22px;
      height: 22px;
    }
  }

  @media (forced-colors: active) {
    .retour-haut {
      border: 2px solid ButtonText;
      background-color: ButtonFace;
      color: ButtonText;
    }
  }

  @media print {
    .retour-haut {
      display: none;
    }
  }
</style>
