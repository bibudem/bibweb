---
/*
 * Socle commun des icônes maison (CustomIcons.jsx et IconeUdeM.jsx de
 * coquille-web). La source déclarait l'icône Sofia et les flèches avec des
 * paramètres positionnels (color, sx, ...props) : aucune prop n'était
 * appliquée et le viewBox 24 × 24 de SvgIcon s'imposait par défaut. Ici,
 * size, color, class et style sont réellement transmis, et chaque icône
 * fournit son propre viewBox.
 *
 * Décorative par défaut (aria-hidden) ; avec aria-label, l'icône porte un
 * sens et devient role="img".
 */
import { enregistrerSymbole } from '@/lib/sprite'

interface Props {
  viewBox: string
  /** Nombre (px) ou longueur CSS */
  size?: number | string
  /** Couleur CSS (de préférence un jeton : var(--bleu-principal)) ; currentColor par défaut */
  color?: string
  'aria-label'?: string
  class?: string
  className?: string
  style?: string | Record<string, string | number>
  /** Graisse des icônes Phosphor, que les cartes donnent à toute icône : sans effet ici */
  weight?: string
  /** Toujours posés ci-dessous : les reprendre du parent les doublerait dans le HTML */
  'aria-hidden'?: 'true' | 'false' | boolean
  focusable?: 'true' | 'false' | boolean
}

// `reste` ne porte plus que l'attribut de portée du parent (data-astro-cid-…),
// ajouté par Astro : le style du parent atteint ainsi le <svg>
const { viewBox, size = '1.5rem', color, 'aria-label': libelle, class: classe, className, style, weight: _graisse, 'aria-hidden': _cache, focusable: _focusable, ...reste } = Astro.props

const taille = typeof size === 'number' ? `${size}px` : String(size)
const styles = [color ? `color:${color}` : '', typeof style === 'string' ? style : style ? Object.entries(style).map(([k, v]) => `${k.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`)}:${v}`).join(';') : '']
  .filter(Boolean)
  .join(';')

// Le dessin va dans la planche de la page (src/lib/sprite.ts) : une icône
// répétée (Sofia des liens rapides, flèches des cartes) n'y est écrite qu'une fois
const id = enregistrerSymbole(Astro.locals, viewBox, (await Astro.slots.render('default')).trim())
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  width={taille}
  height={taille}
  fill="currentColor"
  class:list={['icone-maison', classe, className]}
  style={styles || undefined}
  focusable="false"
  {...(libelle ? { role: 'img', 'aria-label': libelle } : { 'aria-hidden': 'true' })}
  {...reste}><use href={`#${id}`} /></svg>

<style>
  .icone-maison {
    display: inline-block;
    flex: none;
    vertical-align: middle;
  }
</style>
