---
/*
 * Figure d'une :::galerie (RenduDirectives) : photo recadrée et légende (le
 * slot). L'image est chargée par RenduDirectives.
 */
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import Typographie from '@/components/primitives/Typographie.astro'

interface Props {
  image: ImageMetadata
  alt?: string
}

const { image, alt } = Astro.props
---

<figure class="galerie-figure">
  <Picture src={image} alt={alt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[400, 800].filter((l) => l < image.width).concat(Math.min(image.width, 800))} sizes="(min-width: 900px) 30vw, 100vw" loading="lazy" decoding="async" />
  <Typographie variant="body2" component="figcaption" class="galerie-legende">
    <slot />
  </Typographie>
</figure>

<style>
  .galerie-figure {
    flex: 1 1 170px;
    min-width: min(170px, 100%);
    margin: 0;
  }

  .galerie-figure :global(img) {
    display: block;
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: var(--rayon-petit);
  }
</style>
