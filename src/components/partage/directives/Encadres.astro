---
/*
 * Directive :::encadres (RenduDirectives) : encadrés de couleur (Encadre),
 * rendus dans le slot, sur le fond choisi.
 */
import { couleurPalette } from '@/lib/couleurs'

interface Props {
  fond?: string
}

const { fond } = Astro.props
---

<div class="encadres" style={{ '--_fond-encadre': couleurPalette(fond) }}>
  <slot />
</div>

<style>
  /* Encadrés de couleur : un par rangée, deux dès 900 px, même hauteur */
  .encadres {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--espace-grille);
    margin-block: var(--espace-bloc);
  }

  @media (width >= 900px) {
    .encadres {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
