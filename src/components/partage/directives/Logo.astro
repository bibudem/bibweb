---
/*
 * Logo d'une grille :::logos (RenduDirectives), avec ou sans lien. L'image
 * est chargée par RenduDirectives.
 */
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import Lien from '@/components/primitives/Lien.astro'
import { largeursHauteur } from './images'

interface Props {
  image: ImageMetadata
  alt?: string
  lien?: string
}

const { image, alt, lien } = Astro.props
const visuel = { src: image, alt, formats: ['avif', 'webp'], fallbackFormat: 'webp', ...largeursHauteur(image, 200), loading: 'lazy', decoding: 'async' } as const
---

{/* Sur une ligne : un blanc autour du visuel s'afficherait dans le lien */}
<div class="logo">{lien ? <Lien to={lien}><Picture {...visuel} /></Lien> : <Picture {...visuel} />}</div>

<style>
  .logo {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .logo :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 200px;
    object-fit: contain;
  }
</style>
