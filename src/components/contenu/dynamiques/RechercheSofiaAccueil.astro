---
/*
 * Recherche Sofia de l'accueil (RechercheSofiaAccueil de coquille-web), en
 * bas du BanniereAccueil : un champ arrondi qui lance la recherche dans Sofia
 * (WorldCat Discovery), avec le logo de Sofia à gauche, le lien vers le
 * guide de recherche (?) et le bouton à droite, puis quelques liens vers les
 * autres outils.
 *
 * - Un vrai formulaire GET, partagé avec le menu (@/lib/sofia) : sans
 *   JavaScript, la recherche part quand même.
 * - Le champ a une vraie étiquette (« Rechercher dans Sofia », lue par les
 *   lecteurs d'écran), reprise visuellement par le logo et le placeholder ;
 *   le formulaire est un repère role="search", et le placeholder passe à
 *   4,5:1.
 * - Pas de bande grise translucide à bord net (la source) : un dégradé bleu
 *   foncé monte du bas de la photo. Le texte blanc y fait au moins 8:1 avec
 *   la photo actuelle ; à remesurer quand la photo change.
 */
import { MagnifyingGlassIcon } from '@phosphor-icons/react/dist/ssr/MagnifyingGlass'
import { QuestionIcon } from '@phosphor-icons/react/dist/ssr/Question'
import IconeSofia from '@/components/icones/IconeSofia.astro'
import { ACTION_SOFIA, PARAMETRES_SOFIA } from '@/lib/sofia'
import { classes, fusionnerStyles, type Style } from '@/lib/styles'
import IconeSprite from '@/components/icones/IconeSprite.astro'

interface Props {
  class?: string
  style?: Style
}

const { class: classe, style } = Astro.props

// Liens à valider avec l'équipe
const LIENS = [
  { libelle: 'Recherche avancée', href: 'https://umontreal.on.worldcat.org/advancedsearch' },
  { libelle: 'Bases de données A-Z', href: 'https://boite-outils.bib.umontreal.ca/az.php' },
  { libelle: 'Ressources par discipline', href: 'https://boite-outils.bib.umontreal.ca/disciplines' },
]
---

<div class:list={['bande', classes(classe)]} style={fusionnerStyles(style)}>
  <div class="interieur">
    <form action={ACTION_SOFIA} method="get" role="search" aria-label="Sofia" data-recherche-sofia>
      {Object.entries(PARAMETRES_SOFIA).map(([nom, valeur]) => <input type="hidden" name={nom} value={valeur} />)}
      <div class="champ surface-claire">
        <label for="recherche-sofia-accueil" class="etiquette">
          <IconeSofia size={28} class="logo" aria-hidden="true" />
          <span class="masque">Rechercher dans Sofia</span>
        </label>
        <input
          id="recherche-sofia-accueil"
          class="saisie"
          type="search"
          name="queryString"
          placeholder="Rechercher dans Sofia : livres, articles, films…"
          required
          autocomplete="off"
        />
        <a
          class="aide infobulle infobulle-dessus"
          href="https://boite-outils.bib.umontreal.ca/trouver-evaluer/sofia"
          aria-label="Guide de recherche Sofia"
          data-infobulle="Guide de recherche Sofia"
          data-aide-sofia
        >
          <IconeSprite icone={QuestionIcon} size={24} aria-hidden="true" focusable="false" className="icone-aide" />
        </a>
        <button type="submit" class="bouton">
          <IconeSprite icone={MagnifyingGlassIcon} size={24} aria-hidden="true" focusable="false" className="icone" />
          <span class="bouton-texte">Rechercher</span>
        </button>
      </div>
    </form>
    <ul class="liens">
      {
        LIENS.map(({ libelle, href }) => (
          <li>
            <a href={href}>{libelle}</a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  import { brancherRechercheSofia } from '@/lib/sofia'
  import { aChaquePage } from '@/lib/pages'

  // Une seule fois par formulaire (data-branche), même appelée deux fois
  aChaquePage((signal) => {
    brancherRechercheSofia()
    // Échap ferme l'infobulle du ? (WCAG 1.4.13) ; elle revient au
    // prochain survol ou focus (même chose que RetourHaut)
    const aide = document.querySelector<HTMLElement>('[data-aide-sofia]')
    if (!aide) return
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && aide.matches(':hover, :focus-visible')) aide.setAttribute('data-infobulle-fermee', '')
    }, { signal })
    for (const evenement of ['pointerleave', 'blur']) {
      aide.addEventListener(evenement, () => aide.removeAttribute('data-infobulle-fermee'), { signal })
    }
  })
</script>

<style>
  /* Le haut du dégradé, transparent, déborde sur la photo (marge
     négative) : aucun bord net */
  .bande {
    --_hauteur-champ: 56px;
    color: var(--couleur-sur-fonce);
    --couleur-lien: var(--couleur-sur-fonce);
    --couleur-lien-survol: var(--couleur-sur-fonce);
    margin-top: -4rem;
    padding-top: var(--espace-8);
    background: linear-gradient(to top, color-mix(in srgb, var(--bleu-fonce) 85%, transparent) 40%, transparent);
  }

  .interieur {
    max-width: var(--largeur-max);
    margin-inline: auto;
    padding: 1.25rem 16px var(--espace-3);
  }

  /* Bloc centré dans la page : en-tête, champ et liens partagent la même
     largeur (52rem au plus dès 900 px) */
  form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  /* Texte lu par les lecteurs d'écran seulement */
  .masque {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Logo de Sofia au début du champ : un clic dessus donne le focus au
     champ (il est dans l'étiquette) */
  .etiquette {
    display: flex;
    flex-shrink: 0;
    color: var(--couleur-accent);
    cursor: text;
  }

  .etiquette :global(.logo) {
    fill: currentColor;
  }

  /* Guide de recherche : icône seule, cible de 44 px, juste avant le bouton */
  .aide {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--rayon-plein);
    color: var(--couleur-texte);
    transition: background-color var(--duree-courte-4) var(--courbe-standard);
  }

  .aide:hover {
    background-color: color-mix(in srgb, var(--bleu-principal) 6%, transparent);
  }

  .aide:focus-visible {
    outline: 2px solid var(--couleur-accent);
    outline-offset: 2px;
  }

  .aide > :global(.icone-aide) {
    fill: currentColor;
  }

  /* Infobulle du ? : celle du site (global.css, .infobulle-dessus) */
  .aide {
    position: relative;
  }
}

  /* Le ? se rapproche du bouton : un peu d'air avant le bouton plein (dès
     900 px) ; sous 900 px, le bouton n'est qu'une loupe et les deux cibles
     de 44 px se touchent sans se chevaucher */
  .aide {
    margin-inline-end: -0.5rem;
  }

  @media (width < 900px) {
    .aide {
      margin-inline-end: -0.75rem;
    }
  }

  .champ {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    min-height: var(--_hauteur-champ);
    padding: 0 0.375rem 0 1.25rem;
    border-radius: var(--rayon-plein);
    background-color: var(--couleur-surface);
    box-shadow: var(--ombre-1);
  }

  .champ:has(.saisie:focus-visible) {
    outline: 3px solid var(--couleur-sur-fonce);
    outline-offset: 3px;
  }

  .saisie {
    flex: 1 1 auto;
    min-width: 0;
    padding: var(--espace-1) 0;
    border: 0;
    background: transparent;
    color: var(--couleur-texte);
    font: inherit;
  }

  .saisie:focus-visible {
    outline: none;
  }

  .saisie::placeholder {
    color: var(--couleur-texte-secondaire);
    opacity: 1;
  }

  /* La croix d'effacement de type=search fait doublon avec le bouton */
  .saisie::-webkit-search-cancel-button {
    display: none;
  }

  /* Loupe seule sur mobile (le texte masqué reste le nom accessible),
     loupe et « Rechercher » dès 900 px */
  .bouton {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: var(--espace-1);
    min-width: 2.75rem;
    height: 2.75rem;
    padding: 0 0.625rem;
    border: 0;
    border-radius: var(--rayon-plein);
    background: transparent;
    color: var(--couleur-accent);
    font: inherit;
    font-weight: var(--graisse-moyenne);
    cursor: pointer;
    transition:
      background-color var(--duree-courte-4) var(--courbe-standard),
      color var(--duree-courte-4) var(--courbe-standard);
  }

  .bouton:hover {
    background-color: color-mix(in srgb, var(--bleu-principal) 6%, transparent);
  }

  /* Masqué sur mobile (le bouton n'est qu'une loupe), affiché dès 1200 px */
  .bouton-texte {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }


  /* Le SVG vient de React : il ne porte pas l'attribut de portée d'Astro */
  .bouton > :global(.icone) {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  /* Liens d'appoint, discrets pour ne pas concurrencer la barre : petit
     texte en blanc atténué (75 % : plus de 9:1 sur le bleu foncé de la
     bande), séparés par des points médians ; blanc plein au survol */
  .liens {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.125rem 0;
    margin: 0.625rem 0 0;
    padding: 0;
    list-style: none;
    color: color-mix(in srgb, var(--couleur-sur-fonce) 75%, transparent);
    font-size: var(--texte-tres-petit);
  }

  /* Sous 600 px, les liens passent à la ligne : un espace plutôt qu'un
     point, qui commencerait la deuxième ligne */
  .liens {
    column-gap: var(--espace-3);
  }

  @media (width >= 600px) {
    .liens {
      column-gap: 0;
    }

    .liens li + li::before {
      content: '·';
      margin-inline: 0.625rem;
    }
  }

  .liens a {
    color: inherit;
    transition: color var(--duree-courte-4) var(--courbe-standard);
  }

  .liens a:hover,
  .liens a:focus-visible {
    color: var(--couleur-sur-fonce);
  }

  /* Liens isolés, hors d'une phrase : pas de soulignement au repos
     (WCAG 1.4.1 ne vise que les liens dans un texte), il revient au survol
     et au focus */
  .liens a {
    text-decoration: none;
    text-underline-offset: 0.2em;
  }

  .liens a:hover,
  .liens a:focus-visible {
    text-decoration: underline;
  }

  @media (width >= 600px) {
    .interieur {
      padding-inline: 20px;
    }
  }

  /* Dès 900 px, la marge de 40 px des pages dégage aussi le bouton de la
     poignée fixe des liens rapides (40 px au bord droit) */
  @media (width >= 900px) {
    .interieur {
      padding: var(--espace-3) 40px 1.75rem;
    }

    .champ {
      width: min(100%, 52rem);
    }

    .bouton {
      padding-inline: 1.25rem;
      background-color: var(--bleu-principal);
      color: var(--couleur-sur-fonce);
    }

    .bouton:hover {
      background-color: var(--bleu-principal-fonce);
    }

    .bouton-texte {
      position: static;
      width: auto;
      height: auto;
      clip-path: none;
    }
  }

  @media (width >= 1200px) {
    .bande {
      --_hauteur-champ: 72px;
    }

    .interieur {
      padding: var(--espace-4) 64px 2.25rem;
    }

    .champ {
      padding-left: var(--espace-4);
      font-size: var(--texte-moyen);
    }

    .bouton {
      height: 3.25rem;
    }
  }

  @media (forced-colors: active) {
    .champ {
      border: 1px solid CanvasText;
    }
  }
</style>
