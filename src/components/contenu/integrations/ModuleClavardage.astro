---
/*
 * Fenêtre de clavardage LibChat (UneQuestion) intégrée dans la page.
 *
 * Dans coquille-web, le module LibChat servait au bouton « Clavarder » des
 * liens rapides ; ce rôle est repris par src/components/coquille/LiensRapides.astro
 * (hash 71ff…). Ce composant remplace le WidgetClavardage que
 * nous-joindre/clavarder.mdx déclarait avec un useEffect : le hash par
 * défaut est celui de ce widget intégré. Le script n'est chargé qu'une fois
 * par hash, et un échec de chargement est annoncé dans la page (la source
 * utilisait alert()).
 *
 * Hauteur : LibChat fixe sa fenêtre à 400 px (règle sur l'id, en px fixes).
 * On l'agrandit (480 px, 520 px sur grand écran) pour que la conversation
 * ait de la place sous le message d'accueil ; il faut !important pour passer
 * devant sa règle à id. Le conteneur réserve cette hauteur dès le HTML, avec
 * « Chargement du clavardage… » par-dessus : sans elle, la fenêtre poussait
 * le contenu à son arrivée (CLS 0,12 à 390 px). En cas d'échec, la réserve
 * est levée.
 *
 * Largeur : au-delà de 800 px, LibChat centre son contenu (colonne
 * Bootstrap de 800 px) et laisse deux bandes grises vides de chaque côté.
 * La fenêtre s'arrête donc à 800 px, où son contenu la remplit exactement.
 *
 * Le bouton flottant « Ouvrir le clavardage » (coquille/BoutonClavardage)
 * est masqué sur une page qui intègre cette fenêtre : il la chevauchait, et
 * ouvrait une seconde conversation à côté de la première.
 */
interface Props {
  hash?: string
  class?: string
  style?: string
}

const { hash = '9ee6ed73a6fb1854335aacfa8a7497ef4acaff4303c125783909dacc7b3200b9', class: classe, style } = Astro.props
---

<div class:list={['libchat-integre', classe]} style={style} data-libchat={hash}>
  <div id={`libchat_${hash}`} class="cible"></div>
  <p class="chargement message-chargement">Chargement du clavardage…</p>
  <p class="erreur" role="status" data-libchat-erreur></p>
  <noscript><p>Le clavardage a besoin de JavaScript.</p></noscript>
</div>

<script>
  import { aChaquePage } from '@/lib/pages'

  // Navigation côté client : en revenant sur une page qui l'intègre, le
  // conteneur est neuf et vide ; le script de LibChat, qui le remplit à son
  // exécution, est alors réinséré (un script retiré puis remis se réexécute)
  aChaquePage(() => {
  for (const racine of document.querySelectorAll<HTMLElement>('[data-libchat]')) {
    const hash = racine.dataset.libchat
    if (!hash) continue
    document.getElementById(`libchat-script-${hash}`)?.remove()
    const script = document.createElement('script')
    script.id = `libchat-script-${hash}`
    script.src = `https://unequestion.bib.umontreal.ca/load_chat.php?hash=${encodeURIComponent(hash)}`
    script.async = true
    script.onerror = () => {
      const erreur = racine.querySelector<HTMLElement>('[data-libchat-erreur]')
      racine.dataset.etat = 'erreur'
      if (erreur) erreur.textContent = 'Le service de clavardage est temporairement indisponible.'
    }
    document.body.append(script)
  }
  })
</script>

<style>
  .libchat-integre {
    --hauteur-clavardage: 480px;
    position: relative;
    max-width: 100%;
    margin-block: 1.5rem 2rem;
  }

  @media (width >= 900px) {
    .libchat-integre {
      --hauteur-clavardage: 520px;
    }
  }

  .cible {
    min-height: var(--hauteur-clavardage);
  }

  /* Message de chargement (utilitaire .message-chargement) : retiré quand
     la fenêtre arrive ou en cas d'erreur */
  .libchat-integre:has(> .cible:not(:empty)) > .chargement,
  .libchat-integre[data-etat='erreur'] > .chargement {
    display: none;
  }

  .libchat-integre[data-etat='erreur'] > .cible {
    min-height: 0;
  }

  @media (scripting: none) {
    .cible {
      min-height: 0;
    }

    .chargement {
      display: none;
    }
  }

  /* Boîte injectée par LibChat : bordure et coins des cartes du site. Sa
     bordure s'ajoutait à sa largeur de 100 % (content-box) */
  .libchat-integre :global(.lci_chat_load) {
    box-sizing: border-box !important;
    max-width: 800px;
    height: var(--hauteur-clavardage) !important;
    overflow: hidden;
    border: 1px solid var(--couleur-bordure) !important;
    border-radius: var(--rayon-carte);
  }

  .libchat-integre :global(.lci_chat_load iframe) {
    display: block;
    height: 100% !important;
  }

  /* Bouton flottant de la coquille (#s-lch-widget-9467, BoutonClavardage).
     LibChat le pose hors du <body>, directement sous <html> : d’où :root */
  :global(:root:has([data-libchat]) #s-lch-widget-9467) {
    display: none !important;
  }

  /* Toujours rendue (vide, sans hauteur) : une région live doit exister
     avant qu'on y écrive pour être annoncée */
  .erreur {
    margin: 0;
    color: var(--alerte-erreur-icone);
    font-weight: var(--graisse-forte);
  }
</style>
